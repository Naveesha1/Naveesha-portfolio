PORT=5000
NODE_ENV=development

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt hash of your admin password. Generate one with:
#   npm run hash-password -- "your-password-here"
ADMIN_PASSWORD_HASH=

# Optional: point the sqlite file and uploaded images at a persistent disk
# (e.g. a Render disk mounted at /var/data). Defaults to folders next to
# this file, which is fine locally but gets wiped on redeploy on most hosts.
# DB_PATH=/var/data/data.sqlite
# UPLOADS_DIR=/var/data/uploads
